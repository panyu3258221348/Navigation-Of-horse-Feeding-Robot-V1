<?xml version="1.0" ?>
<robot name="super_pi">

    <link name="base_link">
        <visual>
            <origin xyz=" 0 0 0.080" rpy="0 0 0" />
            <geometry>
                <box size="1.02 0.750 0.003"/>
            </geometry>
            <material name="white">
                <color rgba="0.5 0.5 0.5 0.7"/>
            </material>
        </visual>
    </link>

    <joint name="imu_joint" type="fixed">
        <origin xyz="0.33 0.0 0.45" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="gyro_link"/>
    </joint>

    <link name="gyro_link">
        <visual>
            <origin xyz="0 0 0.0" rpy="0 0 0" />
             <geometry>
                <box size="0.05 0.09 0.012"/>
            </geometry>
            <material name="green">
                <color rgba="0 1 1 1"/>
            </material>
        </visual>
    </link>

    <joint name="left_wheel_joint" type="fixed">
        <origin xyz="0.4 0.32 0.18" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="left_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.18" length = "0.14"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
    </link>

    <joint name="right_wheel_joint" type="fixed">
        <origin xyz="0.4 -0.32 0.18" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="right_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.18" length = "0.14"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
    </link>

    <joint name="left_wheel_back_joint" type="fixed">
        <origin xyz="-0.4 0.32 0.18" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="left_wheel_back_link"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="left_wheel_back_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.18" length = "0.14"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
    </link>

    <joint name="right_wheel_back_joint" type="fixed">
        <origin xyz="-0.4 -0.32 0.18" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="right_wheel_back_link"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="right_wheel_back_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.18" length = "0.14"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
    </link>


    <joint name="zhu_zi_1_joint" type="fixed">
        <origin xyz="0.17 -0.16 0.27" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="zhu_zi_1_link"/>
    </joint>

    <link name="zhu_zi_1_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
             <geometry>
                <box size="0.02 0.02 0.38"/>
            </geometry>
            <material name="red">
                <color rgba="0.5 0.5 0.5 0.7"/>
            </material>
        </visual>
    </link>

       <joint name="zhu_zi_2_joint" type="fixed">
        <origin xyz="0.17 0.16 0.27" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="zhu_zi_2_link"/>
    </joint>

    <link name="zhu_zi_2_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
             <geometry>
                <box size="0.02 0.02 0.38"/>
            </geometry>
            <material name="red">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
    </link>

      <joint name="zhu_zi_3_joint" type="fixed">
        <origin xyz="-0.17 0.16 0.27" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="zhu_zi_3_link"/>
    </joint>

    <link name="zhu_zi_3_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
             <geometry>
                <box size="0.02 0.02 0.38"/>
            </geometry>
            <material name="red">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
    </link>

     <joint name="zhu_zi_4_joint" type="fixed">
        <origin xyz="-0.17 -0.16 0.27" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="zhu_zi_4_link"/>
    </joint>

    <link name="zhu_zi_4_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
             <geometry>
                <box size="0.02 0.02 0.38"/>
            </geometry>
            <material name="red">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
    </link>


      <joint name="sencond_base_joint" type="fixed">
        <origin xyz="0 0 0.45" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="sencond_base_link"/>
    </joint>
      <link name="sencond_base_link">
        <visual>
            <origin xyz=" 0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="1.02 0.75 0.003"/>
            </geometry>
            <material name="white">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
    </link>


     <joint name="lidar_joint" type="fixed">
        <origin xyz="0.33 0 0.74" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="base_scan"/>
    </joint>

    <link name="base_scan">
        <visual>
            <origin xyz="0 0 0.02" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.04" length = "0.045"/>
            </geometry>
            <material name="gray">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
    </link>



   <joint name="third_base_joint" type="fixed">
        <origin xyz="0 0 0.255" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="third_base_link"/>
    </joint>
      <link name="third_base_link">
        <visual>
            <origin xyz=" 0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.46 0.540 0.003"/>
            </geometry>
            <material name="white">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
    </link>

  <joint name="camera_joint" type="fixed">
        <origin xyz="0.50 0.01 0.53" rpy="0 0 0"/>

        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>

    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
             <geometry>
                <box size="0.025 0.085 0.029"/>
            </geometry>
             <material name="yellow">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
    </link>




</robot>